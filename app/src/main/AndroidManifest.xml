<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To notice a change of network (Wi-Fi, mobile data) and reconnect on the new one. / Para notar un cambio de red y reconectar en la nueva. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17 blocks an app's traffic to its own local network without it (a MeshCentral at home or in the office: the
         sign-in timed out with nothing reaching the server). / Android 17 bloquea sin él el tráfico de la app a su propia red local
         (un MeshCentral en casa o en la oficina: la entrada agotaba el tiempo sin llegar nada al servidor). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Only to ask Android for the fingerprint prompt; the app never sees the fingerprint. / Solo para pedir a Android el aviso de huella; la app nunca ve la huella. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- A terminal, the files or a desktop stays connected while you use another app, with a notification saying so.
         Una terminal, los ficheros o un escritorio siguen conectados mientras se usa otra app, con un aviso que lo dice. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Nothing goes to Android's cloud backup: saved servers carry a password encrypted with a key of this phone.
         Nada va a la copia en la nube de Android: los servidores guardados llevan una contraseña cifrada con una llave de este móvil. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeshClient.Starting"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The single sign-on provider's page, in a process of its own: the browser (Chromium, ~70 MB measured on a
             POCO X5) goes away with it instead of staying in the app. / La página del proveedor, en su propio proceso: el
             navegador (~70 MB medidos en un POCO X5) se va con él en vez de quedarse en la app. -->
        <activity
            android:name=".SignOnActivity"
            android:exported="false"
            android:process=":signon"
            android:theme="@style/Theme.MeshClient"
            android:windowSoftInputMode="adjustResize" />
        <service
            android:name=".RemoteSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a remote terminal, file browser or remote desktop session to a device the user opened connected while the user switches to another app; it stops when the user closes it." />
        </service>
    </application>
</manifest>
