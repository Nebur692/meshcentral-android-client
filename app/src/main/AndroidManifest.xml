<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only to ask Android for the fingerprint prompt; the app never sees the fingerprint. / Solo para pedir a Android el aviso de huella; la app nunca ve la huella. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Nothing goes to Android's cloud backup: saved servers carry a password encrypted with a key of this phone.
         Nada va a la copia en la nube de Android: los servidores guardados llevan una contraseña cifrada con una llave de este móvil. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeshClient.Starting"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The single sign-on provider's page, in a process of its own: the browser (Chromium, ~70 MB measured on a
             POCO X5) goes away with it instead of staying in the app. / La página del proveedor, en su propio proceso: el
             navegador (~70 MB medidos en un POCO X5) se va con él en vez de quedarse en la app. -->
        <activity
            android:name=".SignOnActivity"
            android:exported="false"
            android:process=":signon"
            android:theme="@style/Theme.MeshClient"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
